{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Financas": ""
  },
  "Database": {
    "VersaoMySql": "8.4.0",
    "AplicarMigracoesAoIniciar": false
  },
  "Swagger": {
    "Habilitado": false
  },
  "Jwt": {
    "Issuer": "TccProway",
    "Audience": "TccProway.Client"
  },
  "ServicosExternos": {
    "Auth": { "BaseUrl": "", "CaminhoHealth": "/health", "TimeoutSegundos": 10 },
    "IaWhatsApp": { "BaseUrl": "", "CaminhoHealth": "/health", "TimeoutSegundos": 10 },
    "OpenFinance": { "BaseUrl": "", "CaminhoHealth": "/health", "TimeoutSegundos": 10 }
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "UsuarioAutenticado",
        "Match": { "Path": "/gateway/auth/{**resto}" },
        "Transforms": [ { "PathRemovePrefix": "/gateway/auth" } ]
      },
      "auth-login-publico": {
        "ClusterId": "auth",
        "Order": -1,
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/gateway/auth/api/v1/auth/login", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/gateway/auth" } ]
      },
      "auth-renovacao-publica": {
        "ClusterId": "auth",
        "Order": -1,
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/gateway/auth/api/v1/auth/refresh-token", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/gateway/auth" } ]
      },
      "auth-logout-publico": {
        "ClusterId": "auth",
        "Order": -1,
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/gateway/auth/api/v1/auth/logout", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/gateway/auth" } ]
      },
      "auth-cadastro-publico": {
        "ClusterId": "auth",
        "Order": -1,
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/gateway/auth/api/v1/users", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/gateway/auth" } ]
      },
      "ia-whatsapp": {
        "ClusterId": "ia-whatsapp",
        "AuthorizationPolicy": "UsuarioAutenticado",
        "Match": { "Path": "/gateway/ia-whatsapp/{**resto}" },
        "Transforms": [ { "PathRemovePrefix": "/gateway/ia-whatsapp" } ]
      },
      "open-finance": {
        "ClusterId": "open-finance",
        "AuthorizationPolicy": "UsuarioAutenticado",
        "Match": { "Path": "/gateway/open-finance/{**resto}" },
        "Transforms": [ { "PathRemovePrefix": "/gateway/open-finance" } ]
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": { "principal": { "Address": "http://auth:8080/" } }
      },
      "ia-whatsapp": {
        "Destinations": { "principal": { "Address": "http://ia-whatsapp:8080/" } }
      },
      "open-finance": {
        "Destinations": { "principal": { "Address": "http://open-finance:8080/" } }
      }
    }
  }
}
