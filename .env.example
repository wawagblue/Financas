MYSQL_DATABASE=financas
MYSQL_USER=financas_app
# Substitua estes placeholders por senhas fortes antes de iniciar o Compose.
MYSQL_PASSWORD=SUBSTITUA_POR_SENHA_FORTE
MYSQL_ROOT_PASSWORD=SUBSTITUA_POR_OUTRA_SENHA_FORTE

API_PORTA=8081
FRONTEND_PORTA=4200

# Use exatamente os mesmos valores do serviço de autenticação.
# Gere uma chave aleatória com pelo menos 32 bytes para cada ambiente.
JWT_SECRET=
JWT_ISSUER=TccProway
JWT_AUDIENCE=TccProway.Client

AUTH_URL=https://auth.exemplo.invalid/
IA_WHATSAPP_URL=https://ia-whatsapp.exemplo.invalid/
OPEN_FINANCE_URL=https://open-finance.exemplo.invalid/

# Origem explícita autorizada para CORS; sem curingas.
CORS_ORIGIN=http://localhost:4200
